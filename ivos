# HTTP to HTTPS redirects
server {
    if ($host = tiktok-auth.ivos.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name tiktok-auth.ivos.dev;
    listen 80;
    return 404; # managed by Certbot
}

